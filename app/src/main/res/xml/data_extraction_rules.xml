<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup carries her progress (level and stars): a few bytes. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="progress/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="progress/" />
    </device-transfer>
</data-extraction-rules>
